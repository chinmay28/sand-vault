# Built binaries. These patterns MUST stay anchored to the repo root: a bare
# `sand` matches any path component with that name, which silently excluded the
# whole cmd/sand/ package — the CLI was missing from the repository for its
# entire history because of it.
/sand
/sand.exe
/dist/

# Web build
web/node_modules/
web/dist/

# Script faces for the wordmark. A licensed webfont covers your own sites
# rather than redistribution, and a public repository redistributes everything
# in it — so any face dropped in here stays on the machine that builds.
#
# The exception is the one the repository ships: an open-licensed face, cut
# down to the five letters of "Vault" and travelling with its OFL.txt, which is
# exactly what that licence permits. See web/fonts/README.md.
web/fonts/*.woff
web/fonts/*.woff2
web/fonts/*.otf
web/fonts/*.ttf
!web/fonts/wordmark-script.woff2

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Test artifacts
*.test
coverage.out
coverage.html
tests/__pycache__/
.pytest_cache/

# Vaults and shard directories — these hold cloud credentials and encrypted
# file parts and must never be committed.
*.sand
.sand/
