# Built binaries. These patterns MUST stay anchored to the repo root: a bare
# `sand` matches any path component with that name, which silently excluded the
# whole cmd/sand/ package — the CLI was missing from the repository for its
# entire history because of it.
/sand
/sand.exe
/dist/

# Web build
web/node_modules/
web/dist/

# The wordmark's script face. A webfont licence covers your own sites, not
# redistribution, and a public repository redistributes everything in it — so
# the file stays on the machine that builds, and a build without it falls back
# to the platform's own handwriting face. See web/fonts/README.md.
web/fonts/*.woff
web/fonts/*.woff2
web/fonts/*.otf
web/fonts/*.ttf

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Test artifacts
*.test
coverage.out
coverage.html
tests/__pycache__/
.pytest_cache/

# Vaults and shard directories — these hold cloud credentials and encrypted
# file parts and must never be committed.
*.sand
.sand/
